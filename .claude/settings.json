{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)", "Bash(uv run *)", "Bash(uv sync*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)", "Bash(git merge-base*)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git push*)", "Bash(git fetch*)", "Bash(git pull*)",
      "Bash(git switch *)", "Bash(git branch*)", "Bash(git merge *)", "Bash(git rebase *)",
      "Bash(git worktree *)", "Bash(gh pr *)"
    ],
    "deny": [
      "Read(./.env)", "Read(./**/.env)", "Read(./.env.local)", "Read(./**/.venv/**)", "Read(./uv.lock)",
      "Read(./htmlcov/**)", "Read(./.mutmut-cache/**)", "Read(./**/__pycache__/**)",
      "Read(./docs/generated/build-graph.json)",
      "Bash(git push --force*)", "Bash(git push -f*)"
    ]
  },
  "enabledPlugins": { "pyright-lsp@claude-plugins-official": true },
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/agentkit/hook.sh --check", "timeout": 10}]}],
    "PreToolUse": [
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/agentkit/hook.sh pre-edit", "timeout": 10}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/agentkit/hook.sh pre-bash", "timeout": 10}]},
      {"matcher": "Read|Grep|Glob", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/agentkit/hook.sh pre-read", "timeout": 10}]}
    ],
    "PostToolUse": [{"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/agentkit/hook.sh post-edit", "timeout": 60}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/agentkit/hook.sh stop", "timeout": 600}]}]
  }
}
