{% from "macros.jinja" import sorted_imports -%}
"""Alembic environment: the shared `sb_db` runner over the {{ name }} metadata."""

from alembic import context

{% call sorted_imports() %}
from sb_db.alembic_env import run_migrations
from {{ name }}.infrastructure.models import Base
from {{ name }}.infrastructure.settings import load_settings
from {{ name }}.migrate import migrator_url
{% endcall %}

url = context.config.attributes.get("url") or migrator_url(load_settings())
run_migrations(url, Base.metadata)
