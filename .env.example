# Copy to .env (gitignored) for local overrides. Values here are DEV-ONLY defaults.
# Host ports (change if they clash with something else on your machine)
SB_PG_PORT=5432
SB_KAFKA_PORT=9092
SB_TEMPORAL_PORT=7233
SB_TEMPORAL_UI_PORT=8233
SB_KAFKA_UI_PORT=8080
SB_LEDGER_API_PORT=8001
# Postgres role passwords (dev only)
SB_PG_ADMIN_PASSWORD=sb_admin_dev
SB_MIGRATOR_PASSWORD=sb_migrator_dev
SB_APP_PASSWORD=sb_app_dev
SB_READONLY_PASSWORD=sb_readonly_dev
# Auth: dev header auth (X-Tenant-Id / X-Actor). Never enable outside local dev.
SB_AUTH_MODE=dev
SB_ADMIN_USERNAME=admin
SB_ADMIN_PASSWORD=admin_dev
SB_ADMIN_SECRET_KEY=dev-only-admin-secret-change-me-0123456789
