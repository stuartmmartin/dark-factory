{
  "components": {
    "schemas": {
      "AccountIn": {
        "additionalProperties": false,
        "description": "Open an account. The use case validates the name and currency (OpenAccount R1).",
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "currency"
        ],
        "title": "AccountIn",
        "type": "object"
      },
      "AccountListOut": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AccountOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "AccountListOut",
        "type": "object"
      },
      "AccountOut": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "opened_at": {
            "format": "date-time",
            "title": "Opened At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "currency",
          "opened_at"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "BalanceOut": {
        "additionalProperties": false,
        "description": "Decimal strings in the account's currency. `balance` is debits minus credits.",
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "balance": {
            "title": "Balance",
            "type": "string"
          },
          "credits": {
            "title": "Credits",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "debits": {
            "title": "Debits",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "currency",
          "debits",
          "credits",
          "balance"
        ],
        "title": "BalanceOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JournalEntryIn": {
        "additionalProperties": false,
        "description": "Post an entry. The use case checks the balance and the accounts (PostJournalEntry R1-R3);\nthe line bound is repeated here so an oversized body never reaches it.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/JournalLineIn"
            },
            "maxItems": 100,
            "title": "Lines",
            "type": "array"
          }
        },
        "required": [
          "description",
          "lines"
        ],
        "title": "JournalEntryIn",
        "type": "object"
      },
      "JournalEntryOut": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/JournalLineOut"
            },
            "title": "Lines",
            "type": "array"
          },
          "posted_at": {
            "format": "date-time",
            "title": "Posted At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "currency",
          "posted_at",
          "lines"
        ],
        "title": "JournalEntryOut",
        "type": "object"
      },
      "JournalLineIn": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "amount": {
            "description": "Positive, in the account's currency, e.g. 100.00",
            "pattern": "^-?[0-9]{1,20}(\\.[0-9]{1,18})?$",
            "title": "Amount",
            "type": "string"
          },
          "side": {
            "$ref": "#/components/schemas/Side"
          }
        },
        "required": [
          "account_id",
          "side",
          "amount"
        ],
        "title": "JournalLineIn",
        "type": "object"
      },
      "JournalLineOut": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "side": {
            "$ref": "#/components/schemas/Side"
          }
        },
        "required": [
          "account_id",
          "side",
          "amount"
        ],
        "title": "JournalLineOut",
        "type": "object"
      },
      "Side": {
        "enum": [
          "debit",
          "credit"
        ],
        "title": "Side",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ledger",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/v1/accounts": {
      "get": {
        "description": "The caller's accounts, oldest first, at most `limit` (1-200, default 100).",
        "operationId": "list_accounts",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountListOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Accounts"
      },
      "post": {
        "description": "Open an account (201). A replayed `Idempotency-Key` returns the original account (200).",
        "operationId": "open_account",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Idempotent replay"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Open Account"
      }
    },
    "/v1/accounts/{account_id}": {
      "get": {
        "description": "Read one account of the caller's tenant; another tenant's reads as 404.",
        "operationId": "get_account",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Account"
      }
    },
    "/v1/accounts/{account_id}/balance": {
      "get": {
        "description": "Debits, credits and balance (debits minus credits); another tenant's account is 404.",
        "operationId": "get_account_balance",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Account Balance"
      }
    },
    "/v1/journal-entries": {
      "post": {
        "description": "Post a balanced entry (201): debits must equal credits, all accounts in one currency.\nA replayed `Idempotency-Key` returns the original entry (200).",
        "operationId": "post_journal_entry",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalEntryIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalEntryOut"
                }
              }
            },
            "description": "Idempotent replay"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalEntryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Journal Entry"
      }
    }
  }
}
