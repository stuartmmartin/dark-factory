# Database migrations per service (Alembic). SVC=<service> names a directory under services/.
# db-migrate and db-downgrade run in the service's `<svc>-migrate` compose container, which gets
# the <SVC>_* settings from the env file ($(ENV_FILE)); db-revision runs on the host and needs
# the service's settings in the environment (env.py reads <SVC>_MIGRATOR_URL via Settings).
# SVC and M reach the recipe shells through the environment ("$$SVC", "$$M"), never by expanding
# $(SVC) or $(M) into the command text (the same rule as mk/scaffold.mk).
.PHONY: db-migrate db-revision db-downgrade db-check db-shell _require-svc

export SVC M SQL

_require-svc:
	@test -n "$$SVC" || { echo "usage: make $(MAKECMDGOALS) SVC=<service>  (services: $(SERVICES))"; exit 2; }
	@test -d "services/$$SVC/migrations" || { echo "services/$$SVC has no migrations/"; exit 2; }

db-migrate: _require-svc ## Create the DB if needed and upgrade to head: make db-migrate SVC=ledger
	$(COMPOSE) --profile core --profile "$$SVC-migrate" run --rm "$$SVC-migrate"

db-revision: _require-svc ## New autogenerated revision: make db-revision SVC=ledger M="add x"
	@test -n "$$M" || { echo 'usage: make db-revision SVC=<service> M="message"'; exit 2; }
	cd "services/$$SVC" && $(UV) run alembic revision --autogenerate -m "$$M"

db-downgrade: _require-svc ## Downgrade one revision on the local stack: make db-downgrade SVC=ledger
	$(COMPOSE) --profile core --profile "$$SVC-migrate" run --rm "$$SVC-migrate" alembic -c "services/$$SVC/alembic.ini" downgrade -1

# Connects as sb_admin (superuser, so RLS does not apply): local debugging only.
db-shell: _require-svc ## psql on a service's local DB: make db-shell SVC=ledger [SQL='select 1']
	$(COMPOSE) --profile core exec $$(test -t 0 || echo -T) postgres \
		psql -v ON_ERROR_STOP=1 -U sb_admin -d "$$SVC" $${SQL:+-c "$$SQL"}

db-check: _require-svc ## Migration round-trip, single head, no model drift: make db-check SVC=ledger
	$(MAKE) test PKG="services/$$SVC/tests/integration/db/test_migrations.py"
